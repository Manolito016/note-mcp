# Path to the markdown notes vault
# Can be an absolute path like D:/vault or /home/user/notes
NOTES_VAULT_PATH=D:/vault

# Log level for the MCP server (debug, info, warn, error)
LOG_LEVEL=info

# File watching interval in milliseconds (for detecting external changes)
# Set to 0 to disable file watching
NOTES_WATCH_INTERVAL=5000
